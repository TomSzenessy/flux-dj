<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer: keep credentials and set data local. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="flux.xml" />
        <exclude domain="file" path="plex.tsv" />
        <exclude domain="file" path="rekordbox.xml" />
        <exclude domain="file" path="history.tsv" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="flux.xml" />
        <exclude domain="file" path="plex.tsv" />
        <exclude domain="file" path="rekordbox.xml" />
        <exclude domain="file" path="history.tsv" />
    </device-transfer>
</data-extraction-rules>
